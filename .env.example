# Absolute origin of the deployed site. Used as metadataBase so the Open Graph
# image and every canonical resolve to a real URL instead of localhost.
# e.g. https://venkateshserenique.com
#
# Optional on Vercel: if unset, the site falls back to the deployment's own
# hostname (VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL). Set it once a real
# domain is attached, or canonicals will name the .vercel.app host.
NEXT_PUBLIC_SITE_URL=

# ── Google Search Console ────────────────────────────────────────────────────
# The token from the "HTML tag" verification method — the content value only,
# not the whole <meta> tag. Unset means no verification tag is emitted.
#
# Needed to submit the sitemap and to see indexing errors. Without it nobody
# finds out the site dropped out of the index until traffic disappears.
GOOGLE_SITE_VERIFICATION=

# ── Search engine indexing ───────────────────────────────────────────────────
# Off unless this is exactly the string 'true'. While off, robots.txt disallows
# everything and every page carries a noindex tag.
#
# ⚠ Leave this unset for staging, previews and client review builds. Only set
# it to true on the deployment serving the real domain, and only once the
# client has approved the content. An indexed .vercel.app copy competes with
# the real domain for the project's own name and is slow to get removed.
ALLOW_INDEXING=

# ── Lead capture ─────────────────────────────────────────────────────────────
# Enquiries POST to a Google Apps Script web app, which appends a row to a
# Google Sheet AND sends the notification email with MailApp. Both happen
# inside Google — no transactional email service, and no mail credentials in
# this app.
#
# ⚠ This project needs its OWN Apps Script deployment and its own Sheet. Do not
# reuse the Kharadi project's — leads from the two sites would land in one sheet
# with no way to tell them apart.
#
# Full setup steps are at the top of scripts/google-apps-script/Code.gs.
# In short: paste that file into an Apps Script project bound to a NEW Sheet,
# run `setup` once, deploy as a Web app (Execute as: Me, Access: Anyone), then
# put the /exec URL here.
#
# Until LEADS_WEBHOOK_URL is set, nothing is written and nobody is emailed —
# leads are still captured to the server log with a warning saying so.
LEADS_WEBHOOK_URL=

# Must match SHARED_SECRET in Code.gs. Any long random string; the web app is
# open to "Anyone", so this is what keeps strangers out of your sheet.
LEADS_WEBHOOK_SECRET=

# Only used in log messages, so an unconfigured setup says where the lead
# should have gone. The address mail is actually sent to is NOTIFY_EMAIL
# inside Code.gs.
LEAD_TO=pune.blackstonerealty@gmail.com

# Optional. If set, captured leads are also POSTed here as JSON.
CRM_WEBHOOK_URL=
